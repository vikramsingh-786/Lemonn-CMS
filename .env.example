# Copy to .env and fill in locally. Never commit real credentials.
# All variables are server-only: never prefix secrets with NEXT_PUBLIC_.

# PostgreSQL connection for this CMS's own database (never Lemonn production).
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/lemonn_news_cms?schema=public"

# Tavily Search API key (https://tavily.com). Used for sources without a news sitemap
# (Reuters, NSE, BSE) and as a fallback when a sitemap fails.
TAVILY_API_KEY=
