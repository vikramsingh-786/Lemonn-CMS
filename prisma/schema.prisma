// Prisma schema for Lemonn News CMS.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// One research run. `data` is the snapshot the dashboard reads; `evidence` holds the official
/// passages drafting needs and is never returned by the API.
model ResearchRun {
  id            String    @id @db.Uuid
  stage         String
  data          Json
  evidence      Json      @default("{}")
  /// A step request holds the run until this time, so two requests never work on it at once.
  stepLockUntil DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  articles      Article[]
  /// Who started the run (null for runs from before accounts existed).
  createdById   String?   @db.Uuid
  createdBy     User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([stage, updatedAt])
}

/// An editor's working copy of one AI draft (the run's draft stays untouched). Created on first
/// edit; `version` rises on every save so two tabs can't silently overwrite each other.
model Article {
  id             String      @id @default(uuid()) @db.Uuid
  runId          String      @db.Uuid
  run            ResearchRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  /// The story within the run (ResearchDraft.candidateId).
  candidateId    String
  /// draft | ready | rejected
  status         String      @default("draft")
  headline       String
  summary        String
  /// Markdown subset: paragraphs, ## / ### headings, lists, quotes, **bold**, *italic*.
  body           String
  seoTitle       String
  seoDescription String
  category       String
  tags           String[]
  /// Deterministic checks from the last save.
  checks         Json
  version        Int         @default(1)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  /// Who saved it last (null for edits from before accounts existed).
  updatedById    String?     @db.Uuid
  updatedBy      User?       @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([runId, candidateId])
  @@index([status, updatedAt])
}

/// A CMS account. Grant access by changing `role` here: admin | team | user.
model User {
  id           String        @id @default(uuid()) @db.Uuid
  /// Lower-cased; one account per address.
  email        String        @unique
  name         String
  /// scrypt hash with its parameters and salt (never the password).
  passwordHash String
  /// admin: everything, incl. the user list · team: research and article editing · user: read-only
  role         String        @default("user")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  sessions     Session[]
  runs         ResearchRun[]
  articles     Article[]
}

/// A signed-in browser. The cookie holds a random token; only its SHA-256 is stored here, so
/// this table can't be used to sign in. Deleting a row signs that browser out.
model Session {
  /// SHA-256 (hex) of the cookie token.
  id         String   @id
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Idle timeout: pushed forward while the session is used.
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([userId])
}

/// Failed sign-ins and sign-ups, for attempt limiting ("ip:<address>" or "email:<address>").
model LoginAttempt {
  id        String   @id @default(uuid()) @db.Uuid
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}
